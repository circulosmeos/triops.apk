<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="3"
    android:versionName="1.7" >

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme" 
        android:supportsRtl="true">

        <activity
            android:exported="true"
            android:label="@string/app_name" 
            android:configChanges="orientation|screenSize"
            android:launchMode="singleTask"
            android:name=".MainActivity">

            <!-- 1. Filter for the Launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 2. Filter for the "Share" / "Send" Menu (CRITICAL FOR SHARING) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- We ONLY put the mimeType here. No schemes. -->
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- 3. Filter for "Open With" / File Managers -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.orleonsoft.android.simplefilechooser.ui.FileChooserActivity"
            android:configChanges="orientation|screenSize"
            android:label="@string/app_name" >
            <!--android:screenOrientation="portrait"-->
        </activity>

    </application>

</manifest>
